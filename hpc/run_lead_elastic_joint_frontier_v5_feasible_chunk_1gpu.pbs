#!/bin/bash
#PBS -N lead_ej5r
#PBS -q v1_gpu72
#PBS -l select=1:ncpus=8:mem=32gb:ngpus=1:gpu_type=RTX6000
#PBS -l walltime=18:00:00
#PBS -o /path/to/CSDNet/logs/lead_elastic_joint_v5r_out.log
#PBS -e /path/to/CSDNet/logs/lead_elastic_joint_v5r_err.log

set -euo pipefail

ROOT="${ROOT:-/path/to/CSDNet}"
SEED="${SEED:?SEED=0,1,2 is required}"
CHUNK="${CHUNK:?CHUNK=0..5 is required}"
SAMPLER_PROFILE="${SAMPLER_PROFILE:-elastic_joint_frontier_v5}"
CKPT_PATH="${CKPT_PATH:-csdnet_checkpoints_6m_loflex_geometric_genmol50k/last.ckpt}"
ATOMIC_LENGTH_PRIOR="${ATOMIC_LENGTH_PRIOR:-data/zinc250k_csdnet_atomic_lengths_max256.json}"
OUT_DIR="${OUT_DIR:-CSDNet/exp/lead/results_elastic_joint_frontier_v5r_final_base50k_seed${SEED}}"
RUN_TAG="${RUN_TAG:-elastic_joint_v5r_final_base50k_s${SEED}}"
SKIP_DONE="${SKIP_DONE:-1}"
RESUME_PARTIAL="${RESUME_PARTIAL:-1}"
REQUIRE_RESULT="${REQUIRE_RESULT:-1}"
NUM_ITER="${NUM_ITER:-10}"
ORACLE_BUDGET="${ORACLE_BUDGET:-1000}"
MAX_GENERATION_ROUNDS="${MAX_GENERATION_ROUNDS:-4}"
MAX_PROPOSAL_INPUTS_PER_ITERATION="${MAX_PROPOSAL_INPUTS_PER_ITERATION:-600}"
DIRECT_OVERGENERATE_FACTOR="${DIRECT_OVERGENERATE_FACTOR:-3.0}"
MIN_ORACLE_CALLS="${MIN_ORACLE_CALLS:-0}"

cd "$ROOT"
module load Python/3.10.8-GCCcore-12.2.0
source "${VENV_PATH:-$ROOT/.venv}/bin/activate"
export PYTHONPATH="$ROOT:${PYTHONPATH:-}"
export TOKENIZERS_PARALLELISM=false
export PYTHONUNBUFFERED=1
export TF_CPP_MIN_LOG_LEVEL=3
export CSDNET_LOCAL_SAMPLER_PROFILE=legacy

if ! [[ "$SEED" =~ ^[0-2]$ ]] || ! [[ "$CHUNK" =~ ^[0-5]$ ]]; then
    echo "SEED must be 0..2 and CHUNK must be 0..5; got SEED=$SEED CHUNK=$CHUNK"
    exit 2
fi
if [ "$SAMPLER_PROFILE" != "elastic_joint_frontier_v5" ]; then
    echo "Unsupported SAMPLER_PROFILE: $SAMPLER_PROFILE"
    exit 2
fi
for REQUIRED in "$CKPT_PATH" "$ATOMIC_LENGTH_PRIOR" csdnet_vocab.pkl; do
    if [ ! -s "$REQUIRED" ]; then
        echo "Missing or empty required file: $REQUIRED"
        exit 2
    fi
done
grep -Fq 'def _elastic_joint_v5_preselect' CSDNet/exp/lead/run.py || {
    echo "Lead v5 feasible-only proposal frontier is missing"
    exit 2
}
grep -Fq 'oracle_feasible_only' CSDNet/exp/lead/run.py || {
    echo "Lead oracle feasibility gate is missing"
    exit 2
}
grep -Fq 'def token_safe_model_smiles' CSDNet/exp/lead/run.py || {
    echo "Lead vocabulary-safe seed normalization is missing"
    exit 2
}
grep -Fq 'learned_insertion_trajectory_mode="plan_then_fill"' \
    CSDNet/exp/lead/run.py || {
    echo "Progressive Lead insertion trajectory is missing"
    exit 2
}
grep -Fq 'max_proposal_inputs_per_iteration' CSDNet/exp/lead/run.py || {
    echo "Bounded Lead proposal refill is missing"
    exit 2
}
grep -Fq 'online_scan_progressive_completion_neural_then_projection' \
    CSDNet/util/elastic_sampling.py || {
    echo "True FSM pipeline is missing"
    exit 2
}

case "$CHUNK" in
    0)
        # All delta=0.4 cells. Historically slow cells are placed last so a
        # walltime interruption cannot hide completed easy cells behind them.
        TASKS=(
            "parp1:0:0.4" "parp1:1:0.4" "parp1:2:0.4"
            "fa7:0:0.4" "fa7:2:0.4"
            "5ht1b:1:0.4" "5ht1b:2:0.4"
            "braf:0:0.4" "braf:1:0.4" "braf:2:0.4"
            "jak2:0:0.4" "jak2:1:0.4" "jak2:2:0.4"
            "5ht1b:0:0.4" "fa7:1:0.4"
        )
        ;;
    1)
        # Repeatedly observed slow cell (historical task 09).
        TASKS=("fa7:1:0.6")
        ;;
    2)
        # Repeatedly observed slow cell (historical task 13).
        TASKS=("5ht1b:0:0.6")
        ;;
    3)
        # The remaining FA7 high-similarity cells are isolated from easy work.
        TASKS=("fa7:0:0.6" "fa7:2:0.6")
        ;;
    4)
        TASKS=(
            "parp1:0:0.6" "parp1:1:0.6" "parp1:2:0.6"
            "5ht1b:1:0.6" "5ht1b:2:0.6"
        )
        ;;
    5)
        TASKS=(
            "braf:0:0.6" "braf:1:0.6" "braf:2:0.6"
            "jak2:0:0.6" "jak2:1:0.6" "jak2:2:0.6"
        )
        ;;
esac

if [ -n "${TASK_SPECS:-}" ]; then
    IFS=' ' read -r -a TASKS <<< "$TASK_SPECS"
fi

mkdir -p logs "$OUT_DIR"
LIVE_LOG="logs/csdnet_lead_${RUN_TAG}_chunk${CHUNK}_live.log"
exec > >(tee -a "$LIVE_LOG") 2>&1

python - <<'PY' || exit 3
import shutil
import torch

if not torch.cuda.is_available():
    raise RuntimeError("CUDA is unavailable")
if shutil.which("obabel") is None:
    raise RuntimeError("obabel is unavailable")
from openbabel import pybel  # noqa: F401
x = torch.ones(1, device="cuda")
torch.cuda.synchronize()
print("CUDA/docking preflight passed:", torch.cuda.get_device_name(0), x.item())
PY

ASSIGNED=0
FAILED=0
for SPEC in "${TASKS[@]}"; do
    IFS=: read -r TARGET START_ID SIM_THR <<< "$SPEC"
    ASSIGNED=$((ASSIGNED + 1))
    RESULT="$OUT_DIR/${TARGET}_id${START_ID}_thr${SIM_THR}_${SEED}.csv"
    TASK_MARKER="$OUT_DIR/.${RUN_TAG}_${TARGET}_id${START_ID}_thr${SIM_THR}.done"
    if [ "$SKIP_DONE" = "1" ] && [ -s "$RESULT" ] && [ -f "$TASK_MARKER" ]; then
        echo "Skipping verified task result: $RESULT"
        continue
    fi

    RESUME_ARGS=()
    if [ "$RESUME_PARTIAL" = "1" ] && [ -s "$RESULT" ] && [ ! -f "$TASK_MARKER" ]; then
        RESUME_ARGS=(--resume)
        echo "Resuming partial task result: $RESULT"
    fi

    echo "======================================================================"
    echo "Lead v5 start: target=$TARGET id=$START_ID threshold=$SIM_THR seed=$SEED time=$(date)"
    set +e
    python -m CSDNet.exp.lead.run \
        --ckpt_path "$CKPT_PATH" \
        --vocab csdnet_vocab.pkl \
        --atomic_length_prior "$ATOMIC_LENGTH_PRIOR" \
        --oracle_name "$TARGET" \
        --start_mol_idx "$START_ID" \
        --sim_thr "$SIM_THR" \
        --seed "$SEED" \
        --sampler_profile "$SAMPLER_PROFILE" \
        --output_dir "$OUT_DIR" \
        --num_gen 100 \
        --num_iter "$NUM_ITER" \
        --min_oracle_calls "$MIN_ORACLE_CALLS" \
        --oracle_budget "$ORACLE_BUDGET" \
        --oracle_feasible_only \
        --global_oracle_dedup \
        --max_generation_rounds "$MAX_GENERATION_ROUNDS" \
        --max_proposal_inputs_per_iteration \
            "$MAX_PROPOSAL_INPUTS_PER_ITERATION" \
        --batch_size 64 \
        --n_steps 256 \
        --max_len 256 \
        --min_atoms 10 \
        --max_atoms 80 \
        --max_sample_retries 2 \
        --violation_neighborhood 2 \
        --learned_insertion_max_per_step 4 \
        --direct_length_quantile_low 0.02 \
        --direct_length_quantile_high 0.98 \
        --direct_parent_pool_size 64 \
        --frontier_archive_size 160 \
        --direct_peripheral_probability 0.72 \
        --direct_overgenerate_factor "$DIRECT_OVERGENERATE_FACTOR" \
        "${RESUME_ARGS[@]}"
    STATUS=$?
    set -e
    if [ "$STATUS" -ne 0 ]; then
        echo "Lead v5r task failed: $TARGET:$START_ID:$SIM_THR status=$STATUS"
        FAILED=1
        continue
    fi
    if [ ! -s "$RESULT" ]; then
        echo "Lead v5r produced no feasible docking candidate: $TARGET:$START_ID:$SIM_THR"
        if [ "$REQUIRE_RESULT" = "1" ]; then
            FAILED=1
        fi
        continue
    fi
    if ! python -m CSDNet.exp.lead.verify_feasible_result \
        "$RESULT" \
        --sim_threshold "$SIM_THR" \
        --min_calls "$MIN_ORACLE_CALLS" \
        --oracle_budget "$ORACLE_BUDGET"; then
        echo "Lead v5r completion verification failed: $RESULT"
        FAILED=1
        continue
    fi

    touch "$TASK_MARKER"
    python -m CSDNet.exp.lead.eval \
        "$RESULT" -d "$SIM_THR" --planned_total 1000 || true
    echo "Lead v5r done: rows=$(wc -l < "$RESULT") time=$(date)"
done

if [ "$FAILED" -eq 0 ]; then
    touch "$OUT_DIR/.seed${SEED}_${SAMPLER_PROFILE}_chunk${CHUNK}.done"
fi
DONE_COUNT=$(find "$OUT_DIR" -maxdepth 1 -type f \
    -name ".seed${SEED}_${SAMPLER_PROFILE}_chunk*.done" | wc -l | tr -d ' ')
if [ "$DONE_COUNT" -eq 6 ]; then
    python -m CSDNet.exp.lead.aggregate \
        --input_dir "$OUT_DIR" \
        --output "$OUT_DIR/lead_summary.csv" \
        --planned_total 1000 || FAILED=1
    python -m CSDNet.exp.lead.invirtuogen_score \
        --input_dir "$OUT_DIR" \
        --planned_total 1000 \
        --expected_random_seeds 1 \
        --run_output "$OUT_DIR/invirtuogen_score_runs.csv" \
        --cell_output "$OUT_DIR/invirtuogen_score_cells.csv" || FAILED=1
fi

echo "Lead v5r chunk complete: seed=$SEED chunk=$CHUNK assigned=$ASSIGNED failed=$FAILED time=$(date)"
exit "$FAILED"
