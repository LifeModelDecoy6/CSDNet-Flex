#!/bin/bash
#PBS -N b6dn_seed
#PBS -q v1_gpu72
#PBS -l select=1:ncpus=8:mem=32gb:ngpus=1:gpu_type=RTX6000
#PBS -l walltime=02:00:00
#PBS -o /path/to/CSDNet/logs/b6dn_seed_out.log
#PBS -e /path/to/CSDNet/logs/b6dn_seed_err.log
#PBS -M your.email@example.org
#PBS -m abe

set -euo pipefail

ROOT=/path/to/CSDNet
cd "$ROOT"
mkdir -p logs results

module load Python/3.10.8-GCCcore-12.2.0
source "${VENV_PATH:-$ROOT/.venv}/bin/activate"

export PYTHONPATH="$ROOT:${PYTHONPATH:-}"
export PYTHONUNBUFFERED=1
export TOKENIZERS_PARALLELISM=false
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

SEED="${SEED:?SEED is required}"
CKPT_PATH="${CKPT_PATH:-csdnet_checkpoints_6m_loflex_geometric_genmol50k/last.ckpt}"
OUT_DIR="${OUT_DIR:-results/csdnet_6m_loflex_geometric_base50k_denovo_3seed}"
N_STEPS="${N_STEPS:-1000}"
PROFILE=elastic_loflex

for REQUIRED in "$CKPT_PATH" csdnet_vocab.pkl; do
    if [ ! -s "$REQUIRED" ]; then
        echo "Missing or empty required file: $REQUIRED"
        exit 2
    fi
done

export HF_HOME="${HF_HOME:-$HOME/.cache/huggingface}"
if [ -z "${HF_TOKEN:-}" ]; then
    for TOKEN_FILE in \
        "$HF_HOME/token" \
        "$HOME/.cache/huggingface/token" \
        "$HOME/.huggingface/token"; do
        if [ -s "$TOKEN_FILE" ]; then
            HF_TOKEN="$(tr -d '\r\n' < "$TOKEN_FILE")"
            export HF_TOKEN
            break
        fi
    done
fi
if [ -z "${HF_TOKEN:-}" ]; then
    echo "HF_TOKEN is unavailable in the environment or standard token files."
    exit 2
fi

JOB_TAG="${PBS_JOBID:-manual}"
LIVE_LOG="logs/base6m_denovo_seed${SEED}_${JOB_TAG}_live.log"
exec > >(tee -a "$LIVE_LOG") 2>&1

echo "Base 6M de novo start: seed=$SEED time=$(date)"
echo "Checkpoint=$CKPT_PATH profile=$PROFILE steps=$N_STEPS"
nvidia-smi --query-gpu=index,name,memory.total,memory.free --format=csv,noheader

python - <<'PY'
import torch

if not torch.cuda.is_available():
    raise RuntimeError("CUDA is unavailable")
x = torch.ones(4, device="cuda")
torch.cuda.synchronize()
print("CUDA preflight passed:", torch.cuda.get_device_name(0), x.sum().item())
PY

RUN_DIR="$OUT_DIR/steps${N_STEPS}/${PROFILE}/seed${SEED}"
if [ -s "$RUN_DIR/genmol_denovo_metrics.json" ]; then
    echo "Seed $SEED is already complete; skipping."
    exit 0
fi
mkdir -p "$RUN_DIR"

python -m CSDNet.exp.denovo.evaluate \
    --ckpt_path "$CKPT_PATH" \
    --hf_dataset datamol-io/safe-gpt \
    --hf_split train \
    --hf_smiles_col auto \
    --hf_safe_col safe \
    --hf_streaming \
    --hf_token_env HF_TOKEN \
    --hf_ref_sample_n 50000 \
    --hf_novelty_sample_n 200000 \
    --hf_scan_limit 1000000 \
    --vocab csdnet_vocab.pkl \
    --seed "$SEED" \
    --n_mol 1000 \
    --batch_size 128 \
    --n_steps "$N_STEPS" \
    --max_len 256 \
    --output_dir "$RUN_DIR" \
    --sampler_profile "$PROFILE" \
    --unmask_selection top_prob \
    --max_sample_retries 3 \
    --violation_neighborhood 2 \
    --strict_final_sanitize \
    --max_refill_factor 1.5

python evaluate_genmol_denovo_metrics.py \
    --input "$RUN_DIR/generated_mols.txt" \
    --output_dir "$RUN_DIR" \
    --num_samples 1000 \
    --qed_threshold 0.6 \
    --sa_threshold 4.0 \
    --fp_nbits 2048

test -s "$RUN_DIR/genmol_denovo_metrics.json" || {
    echo "Completion verification failed: $RUN_DIR/genmol_denovo_metrics.json"
    exit 3
}
echo "Base 6M de novo complete: seed=$SEED time=$(date)"
