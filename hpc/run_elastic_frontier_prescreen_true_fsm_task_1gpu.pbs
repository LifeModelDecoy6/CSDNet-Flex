#!/bin/bash
#PBS -N pmo_eftfsm
#PBS -q v1_gpu72
#PBS -l select=1:ncpus=8:mem=48gb:ngpus=1:gpu_type=RTX6000
#PBS -l walltime=04:00:00
#PBS -o /path/to/CSDNet/logs/pmo_eftfsm_out.log
#PBS -e /path/to/CSDNet/logs/pmo_eftfsm_err.log

set -euo pipefail

ROOT="${ROOT:-/path/to/CSDNet}"
cd "$ROOT"

export SEED="${SEED:-0}"
export TASK_INDEX="${TASK_INDEX:?TASK_INDEX=0..22 is required}"
export CKPT_PATH="${CKPT_PATH:-csdnet_checkpoints_6m_loflex_geometric_genmol50k/last.ckpt}"
export ATOMIC_LENGTH_PRIOR="${ATOMIC_LENGTH_PRIOR:-data/zinc250k_csdnet_atomic_lengths_max256.json}"
export OUT_DIR="${OUT_DIR:-CSDNet/exp/pmo/results/elastic_frontier_prescreen_truefsm_base50k_10k_seed0}"
export MAX_CALLS="${MAX_CALLS:-10000}"
export MAX_LEN="${MAX_LEN:-256}"
export MODE="elastic_frontier_prescreen"
export RUN_TAG="${RUN_TAG:-elastic_frontier_prescreen_truefsm_base50k_s0}"
export SKIP_DONE="${SKIP_DONE:-1}"

grep -q '_repair_final_sequences' CSDNet/exp/pmo/optimizer.py || {
    echo "PMO fixed/fallback proposal path is missing final FSM repair"
    exit 2
}
grep -q 'online_scan_progressive_completion_neural_then_projection' \
    CSDNet/util/elastic_sampling.py || {
    echo "Elastic sampler is missing the true FSM constraint pipeline"
    exit 2
}

exec bash "$ROOT/hpc/run_iterative_remask_v9_10k_task_1gpu.pbs"
